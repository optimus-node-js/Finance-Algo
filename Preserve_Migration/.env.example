# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# Local PostgreSQL Database
LOCAL_DB_USER=postgres
LOCAL_DB_PASS=your_password_here
LOCAL_DB_HOST=localhost
LOCAL_DB_PORT=5432
LOCAL_DB_NAME=postgres

# Neon Cloud Database (Optional - Get free tier at https://neon.tech)
NEON_DB_URL=postgresql://user:***REDACTED***@host/dbname?sslmode=require&channel_binding=require

# ===========================================
# ANGEL ONE API CREDENTIALS
# ===========================================
# Get your API keys from: https://smartapi.angelbroking.com/
# You can add up to 5 API keys for load balancing

# Key 1 (Required)
ANGEL_API_KEY_1=your_api_key_1_here
ANGEL_CLIENT_CODE_1=your_client_code_here
ANGEL_PASSWORD_1=your_password_here
ANGEL_TOTP_SECRET_1=your_totp_secret_here

# Key 2 (Optional)
ANGEL_API_KEY_2=your_api_key_2_here
ANGEL_CLIENT_CODE_2=your_client_code_here
ANGEL_PASSWORD_2=your_password_here
ANGEL_TOTP_SECRET_2=your_totp_secret_here

# Key 3 (Optional)
ANGEL_API_KEY_3=your_api_key_3_here
ANGEL_CLIENT_CODE_3=your_client_code_here
ANGEL_PASSWORD_3=your_password_here
ANGEL_TOTP_SECRET_3=your_totp_secret_here

# Key 4 (Optional)
ANGEL_API_KEY_4=your_api_key_4_here
ANGEL_CLIENT_CODE_4=your_client_code_here
ANGEL_PASSWORD_4=your_password_here
ANGEL_TOTP_SECRET_4=your_totp_secret_here

# Key 5 (Optional)
ANGEL_API_KEY_5=your_api_key_5_here
ANGEL_CLIENT_CODE_5=your_client_code_here
ANGEL_PASSWORD_5=your_password_here
ANGEL_TOTP_SECRET_5=your_totp_secret_here

# ===========================================
# ANGEL ONE WEB SCRAPING (For Token Hunt)
# ===========================================
# These need to be updated frequently as they expire
# Instructions in README.md on how to get these values

# Cookie from browser (expires frequently!)
ANGEL_COOKIE=your_cookie_string_here

# Device ID from browser request headers
ANGEL_DEVICE_ID=your_device_id_here

# Your public IP from browser request headers
ANGEL_CLIENT_IP=your_public_ip_here

# ===========================================
# ENVIRONMENT
# ===========================================
DB_HOST=localhost
